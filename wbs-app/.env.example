# Supabase PostgreSQL 接続文字列
# Supabase ダッシュボード → Project Settings → Database → Connection string (URI) からコピー
DATABASE_URL=postgresql://postgres.YOURPROJECT:YOURPASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# JWT シークレット（ランダムな文字列を設定してください）
# 生成方法: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-this
